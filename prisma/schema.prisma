// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // This is a crucial line that tells Prisma to generate a query engine compatible with various Linux environments,
  // which is common in containers and cloud setups.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "sqlite"
  url        = "file:./dev.db"
  // This line changes the engine loading mechanism to be more compatible with different environments.
  engineType = "library"
}

model District {
  id       String      @id @default(cuid())
  name     String
  branches Branch[]
  leads    SalesLead[]
}

model Branch {
  id         String       @id @default(cuid())
  name       String
  district   District     @relation(fields: [districtId], references: [id])
  districtId String
  officers   Officer[]
  leads      SalesLead[]
  plans      BranchPlan[]
}

model Officer {
  id       String      @id @default(cuid())
  name     String
  branch   Branch      @relation(fields: [branchId], references: [id])
  branchId String
  leads    SalesLead[]
}

model SalesLead {
  id              String       @id @default(cuid())
  title           String
  description     String
  status          String
  district        District     @relation(fields: [districtId], references: [id])
  districtId      String
  branch          Branch?      @relation(fields: [branchId], references: [id])
  branchId        String?
  officer         Officer?     @relation(fields: [officerId], references: [id])
  officerId       String?
  lat             Float
  lng             Float
  expectedSavings Float
  createdAt       DateTime     @default(now())
  deadline        DateTime
  updates         LeadUpdate[]
}

model LeadUpdate {
  id                    String    @id @default(cuid())
  text                  String
  author                String
  timestamp             DateTime  @default(now())
  generatedSavings      Float?
  attachmentJson        String?
  reportingLocationJson String?
  salesLead             SalesLead @relation(fields: [salesLeadId], references: [id])
  salesLeadId           String
}

model BranchPlan {
  id            String      @id
  branch        Branch      @relation(fields: [branchId], references: [id])
  branchId      String
  quarter       String
  savingsTarget Float
  entries       PlanEntry[]

  @@unique([branchId, quarter])
}

model PlanEntry {
  id              String   @id @default(cuid())
  branchPlan      BranchPlan @relation(fields: [branchPlanId], references: [id])
  branchPlanId    String
  date            DateTime @default(now())
  type            String   // 'collection' or 'withdrawal'
  amount          Float
  description     String
  status          String   // 'Pending', 'Approved', 'Rejected'
  submittedBy     String
  reviewedBy      String?
  rejectionReason String?
}
