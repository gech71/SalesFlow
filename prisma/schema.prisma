// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // This is the crucial line that will fix the environment issue.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model District {
  id       String   @id
  name     String
  branches Branch[]
  leads    SalesLead[]
}

model Branch {
  id         String       @id
  name       String
  district   District     @relation(fields: [districtId], references: [id])
  districtId String
  officers   Officer[]
  leads      SalesLead[]
  plans      BranchPlan[]
}

model Officer {
  id       String      @id
  name     String
  branch   Branch      @relation(fields: [branchId], references: [id])
  branchId String
  leads    SalesLead[]
}

model SalesLead {
  id              String       @id
  title           String
  description     String
  status          LeadStatus   @default(New)
  district        District     @relation(fields: [districtId], references: [id])
  districtId      String
  branch          Branch?      @relation(fields: [branchId], references: [id])
  branchId        String?
  officer         Officer?     @relation(fields: [officerId], references: [id])
  officerId       String?
  lat             Float
  lng             Float
  expectedSavings Float
  createdAt       DateTime     @default(now())
  deadline        DateTime
  updates         LeadUpdate[]
}

model LeadUpdate {
  id                      Int       @id @default(autoincrement())
  text                    String
  timestamp               DateTime  @default(now())
  author                  String
  generatedSavings        Float?
  attachmentJson          String?
  reportingLocationJson   String?
  salesLead               SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)
  salesLeadId             String
}

model BranchPlan {
  id            String      @id
  branch        Branch      @relation(fields: [branchId], references: [id])
  branchId      String
  quarter       String
  savingsTarget Float
  entries       PlanEntry[]

  @@unique([branchId, quarter])
}

model PlanEntry {
  id              String          @id
  date            DateTime
  type            PlanEntryType
  amount          Float
  description     String
  status          PlanEntryStatus
  submittedBy     String
  reviewedBy      String?
  rejectionReason String?
  branchPlan      BranchPlan      @relation(fields: [branchPlanId], references: [id], onDelete: Cascade)
  branchPlanId    String
}

enum LeadStatus {
  New
  Assigned
  InProgress
  Reopened
  PendingClosure
  PendingDistrictApproval
  Closed
}

enum PlanEntryType {
  collection
  withdrawal
}

enum PlanEntryStatus {
  Pending
  Approved
  Rejected
}
