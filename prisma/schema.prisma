
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Setting {
  key   String @id
  value String
}

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  name        String
  firstName   String?
  lastName    String?
  phoneNumber String? @unique

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  district   District? @relation(fields: [districtId], references: [id])
  districtId String?

  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  assignedLeads SalesLead[] @relation("AssignedLeads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
}

model District {
  id     String @id @default(cuid())
  name   String
  users  User[]

  branches   Branch[]
  salesLeads SalesLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id     String @id @default(cuid())
  name   String
  users  User[]

  district   District @relation(fields: [districtId], references: [id])
  districtId String

  salesLeads SalesLead[]
  plans      BranchPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

model SalesLead {
  id              String   @id @default(cuid())
  title           String
  description     String
  status          String
  lat             Decimal?
  lng             Decimal?
  expectedSavings Decimal
  deadline        DateTime

  district   District @relation(fields: [districtId], references: [id])
  districtId String

  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  assignee   User?       @relation("AssignedLeads", fields: [assigneeId], references: [id])
  assigneeId String?

  updates LeadUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([branchId])
  @@index([assigneeId])
}

model LeadUpdate {
  id              String   @id @default(cuid())
  text            String
  author          String
  generatedSavings Decimal?
  attachmentUrl   String?
  reportingLat    Float?
  reportingLng    Float?
  
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id])
  salesLeadId String

  timestamp DateTime @default(now())

  @@index([salesLeadId])
}

model BranchPlan {
  id            String @id @default(cuid())
  quarter       String
  savingsTarget Decimal

  branch   Branch @relation(fields: [branchId], references: [id])
  branchId String

  entries PlanEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

model PlanEntry {
  id              String  @id @default(cuid())
  date            DateTime
  type            String // "collection" or "withdrawal"
  amount          Decimal
  description     String
  status          String // "Pending", "Approved", "Rejected"
  submittedBy     String
  reviewedBy      String?
  rejectionReason String?
  
  branchPlan   BranchPlan @relation(fields: [branchPlanId], references: [id])
  branchPlanId String

  @@index([branchPlanId])
}
