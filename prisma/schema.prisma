// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model District {
  id         String      @id @default(cuid())
  name       String
  branches   Branch[]
  salesLeads SalesLead[]
}

model Branch {
  id         String       @id @default(cuid())
  name       String
  district   District     @relation(fields: [districtId], references: [id])
  districtId String
  officers   Officer[]
  salesLeads SalesLead[]
  plans      BranchPlan[]
}

model Officer {
  id         String      @id @default(cuid())
  name       String
  branch     Branch      @relation(fields: [branchId], references: [id])
  branchId   String
  salesLeads SalesLead[]
}

model SalesLead {
  id              String       @id @default(cuid())
  title           String
  description     String
  status          SalesLeadStatus @default(New)
  district        District?    @relation(fields: [districtId], references: [id])
  districtId      String?
  branch          Branch?      @relation(fields: [branchId], references: [id])
  branchId        String?
  officer         Officer?     @relation(fields: [officerId], references: [id])
  officerId       String?
  lat             Float?
  lng             Float?
  expectedSavings Decimal
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deadline        DateTime?
  updates         LeadUpdate[]
}

model LeadUpdate {
  id               String    @id @default(cuid())
  salesLead        SalesLead @relation(fields: [salesLeadId], references: [id])
  salesLeadId      String
  text             String
  author           String
  timestamp        DateTime  @default(now())
  generatedSavings Decimal?
  attachmentUrl    String?
  reportingLat     Float?
  reportingLng     Float?
}

model BranchPlan {
  id             String      @id @default(cuid())
  branch         Branch      @relation(fields: [branchId], references: [id])
  branchId       String
  quarter        String // e.g., "Q3 2024"
  savingsTarget  Decimal
  entries        PlanEntry[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model PlanEntry {
  id              String        @id @default(cuid())
  branchPlan      BranchPlan    @relation(fields: [branchPlanId], references: [id])
  branchPlanId    String
  date            DateTime
  type            PlanEntryType
  amount          Decimal
  description     String
  status          String // Pending, Approved, Rejected
  submittedBy     String // e.g., Officer or Manager name/ID
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

enum SalesLeadStatus {
  New
  Assigned
  InProgress
  Reopened
  PendingClosure
  PendingDistrictApproval
  Closed
}

enum PlanEntryType {
  collection
  withdrawal
}
