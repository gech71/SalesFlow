
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum LeadStatus {
  New
  Assigned
  InProgress
  PendingClosure
  PendingDistrictApproval
  Closed
  Reopened
}

model District {
  id          String      @id @default(cuid())
  name        String
  branches    Branch[]
  salesLeads  SalesLead[]
}

model Branch {
  id          String      @id @default(cuid())
  name        String
  district    District    @relation(fields: [districtId], references: [id])
  districtId  String
  officers    Officer[]
  salesLeads  SalesLead[]
  plans       BranchPlan[]
}

model Officer {
  id         String      @id @default(cuid())
  name       String
  branch     Branch      @relation(fields: [branchId], references: [id])
  branchId   String
  salesLeads SalesLead[]
}

model SalesLead {
  id              String      @id @default(cuid())
  title           String
  description     String
  status          LeadStatus
  district        District    @relation(fields: [districtId], references: [id])
  districtId      String
  branch          Branch?     @relation(fields: [branchId], references: [id])
  branchId        String?
  officer         Officer?    @relation(fields: [officerId], references: [id])
  officerId       String?
  lat             Float
  lng             Float
  createdAt       DateTime    @default(now())
  deadline        DateTime
  expectedSavings Decimal
  updates         LeadUpdate[]
}

model LeadUpdate {
  id                String    @id @default(cuid())
  salesLead         SalesLead @relation(fields: [salesLeadId], references: [id])
  salesLeadId       String
  timestamp         DateTime  @default(now())
  text              String
  author            String
  generatedSavings  Decimal?
  attachmentUrl     String?
  reportingLat      Float?
  reportingLng      Float?
}

enum PlanEntryType {
  collection
  withdrawal
}

enum PlanEntryStatus {
  Pending
  Approved
  Rejected
}

model BranchPlan {
  id            String      @id @default(cuid())
  branch        Branch      @relation(fields: [branchId], references: [id])
  branchId      String
  quarter       String
  savingsTarget Decimal
  entries       PlanEntry[]
}

model PlanEntry {
  id              String          @id @default(cuid())
  branchPlan      BranchPlan      @relation(fields: [branchPlanId], references: [id])
  branchPlanId    String
  date            DateTime
  type            PlanEntryType
  amount          Decimal
  description     String
  status          PlanEntryStatus
  rejectionReason String?
  submittedBy     String
  reviewedBy      String?
}
