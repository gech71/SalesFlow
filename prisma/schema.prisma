
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model District {
  id       String      @id @default(cuid())
  name     String
  branches Branch[]
  leads    SalesLead[]
}

model Branch {
  id         String       @id @default(cuid())
  name       String
  district   District     @relation(fields: [districtId], references: [id])
  districtId String
  officers   Officer[]
  leads      SalesLead[]
  plans      BranchPlan[]
}

model Officer {
  id       String      @id @default(cuid())
  name     String
  branch   Branch      @relation(fields: [branchId], references: [id])
  branchId String
  leads    SalesLead[]
}

model SalesLead {
  id              String       @id @default(cuid())
  title           String
  description     String
  status          LeadStatus   @default(New)
  district        District     @relation(fields: [districtId], references: [id])
  districtId      String
  branch          Branch?      @relation(fields: [branchId], references: [id])
  branchId        String?
  officer         Officer?     @relation(fields: [officerId], references: [id])
  officerId       String?
  lat             Float
  lng             Float
  expectedSavings Decimal
  createdAt       DateTime     @default(now())
  deadline        DateTime
  updates         LeadUpdate[]
}

model LeadUpdate {
  id                    String   @id @default(cuid())
  salesLead             SalesLead @relation(fields: [salesLeadId], references: [id])
  salesLeadId           String
  text                  String
  timestamp             DateTime @default(now())
  author                String
  generatedSavings      Decimal?
  attachmentJson        String?
  reportingLocationJson String?
}

model BranchPlan {
  id            String      @id @default(cuid())
  branch        Branch      @relation(fields: [branchId], references: [id])
  branchId      String
  quarter       String
  savingsTarget Decimal
  entries       PlanEntry[]

  @@unique([branchId, quarter])
}

model PlanEntry {
  id              String          @id @default(cuid())
  branchPlan      BranchPlan      @relation(fields: [branchPlanId], references: [id])
  branchPlanId    String
  date            DateTime        @default(now())
  type            PlanEntryType
  amount          Decimal
  description     String
  status          PlanEntryStatus @default(Pending)
  submittedBy     String
  reviewedBy      String?
  rejectionReason String?
}

enum LeadStatus {
  New
  Assigned
  InProgress
  Reopened
  PendingClosure
  PendingDistrictApproval
  Closed
}

enum PlanEntryType {
  collection
  withdrawal
}

enum PlanEntryStatus {
  Pending
  Approved
  Rejected
}
